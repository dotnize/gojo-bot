{
  "name": "gojo-bot",
  "version": "1.0.0",
  "private": true,
  "description": "A Discord bot.",
  "license": "MIT",
  "author": "Nathaniel John Tampus <nat@nize.ph>",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "deploy-cmds": "node --env-file-if-exists=.env src/deploy-commands.ts",
    "prepare": "husky",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format && pnpm lint",
    "deps": "pnpm dlx taze@latest -Ilw --maturity-period 3",
    "intent": "pnpm dlx @tanstack/intent@latest"
  },
  "dependencies": {
    "@tanstack/ai": "1.0.1",
    "@tanstack/ai-gemini": "1.0.1",
    "discord.js": "14.28.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
